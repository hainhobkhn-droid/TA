{
  "name": "helpa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "worker": "tsx src/server/worker.ts",
    "migrate": "tsx src/server/db/migrate.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "build": "NODE_ENV=production vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/main.js",
    "start:worker": "node dist/server/server/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.json *.yaml deploy .github README.md docs config",
    "format:check": "prettier --check src tests scripts *.ts *.json *.yaml deploy .github README.md docs config"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.3",
    "better-auth": "1.7.3",
    "csv-parse": "7.0.2",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "fastify": "5.12.3",
    "google-auth-library": "11.0.2",
    "i18next": "26.4.2",
    "lucide-react": "1.42.0",
    "nodemailer": "10.0.1",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "react-qr-code": "2.2.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "otpauth": "9.5.2",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
